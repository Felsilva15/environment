{
  "mcpServers": {
    "jev": {
      "command": "node",
      "args": ["./scripts/server.mjs"],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "PATH",
        "USER",
        "TYPESAFE_API_KEY",
        "TYPESAFE_JEV_MODEL"
      ],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 120
    }
  }
}
